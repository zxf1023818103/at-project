# RTL8711F uses the ASDK 12.3.1 soft-float/newlib ABI on both KM4 cores.
if(NOT DEFINED AMEBAGREEN2_TOOLCHAIN_ROOT)
    if(DEFINED ENV{AMEBAGREEN2_TOOLCHAIN_ROOT})
        set(AMEBAGREEN2_TOOLCHAIN_ROOT "$ENV{AMEBAGREEN2_TOOLCHAIN_ROOT}")
    else()
        foreach(candidate
                "${CMAKE_CURRENT_LIST_DIR}/../toolchain/asdk-12.3.1-4568/linux/newlib"
                "/opt/rtk-toolchain/asdk-12.3.1-4568/linux/newlib")
            if(EXISTS "${candidate}/bin/arm-none-eabi-gcc")
                set(AMEBAGREEN2_TOOLCHAIN_ROOT "${candidate}")
                break()
            endif()
        endforeach()
    endif()
endif()
if(NOT AMEBAGREEN2_TOOLCHAIN_ROOT)
    message(FATAL_ERROR "Set AMEBAGREEN2_TOOLCHAIN_ROOT to ASDK 12.3.1-4568's newlib directory")
endif()
set(AMEBAGREEN2_TOOLCHAIN_ROOT "${AMEBAGREEN2_TOOLCHAIN_ROOT}" CACHE PATH "Green2 ASDK root")
set(AMEBAD_TOOLCHAIN_ROOT "${AMEBAGREEN2_TOOLCHAIN_ROOT}")
include(${CMAKE_CURRENT_LIST_DIR}/arm-none-eabi.cmake)
set(_arch "-march=armv8.1-m.main -mthumb -mcmse -mfloat-abi=soft")
string(APPEND CMAKE_C_FLAGS_INIT " ${_arch} -DCONFIG_AMEBAGREEN2 -fno-builtin -fno-strict-aliasing -fno-tree-loop-distribute-patterns")
string(APPEND CMAKE_CXX_FLAGS_INIT " ${_arch} -DCONFIG_AMEBAGREEN2 -fno-builtin -fno-strict-aliasing")
string(APPEND CMAKE_ASM_FLAGS_INIT " ${_arch} -DCONFIG_AMEBAGREEN2")
string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " ${_arch}")
