set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT TL3238_TOOLCHAIN AND DEFINED ENV{TL3238_TOOLCHAIN})
    set(TL3238_TOOLCHAIN "$ENV{TL3238_TOOLCHAIN}")
endif()
if(NOT TL3238_TOOLCHAIN)
    message(FATAL_ERROR "Set TL3238_TOOLCHAIN to the Telink GCC 12.2 installation, or run build.sh")
endif()
set(TL3238_TOOLCHAIN "${TL3238_TOOLCHAIN}" CACHE PATH "Telink Andes GCC root")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TL3238_TOOLCHAIN)
set(_prefix "${TL3238_TOOLCHAIN}/bin/riscv32-elf-")
set(CMAKE_C_COMPILER "${_prefix}gcc")
set(CMAKE_CXX_COMPILER "${_prefix}g++")
set(CMAKE_ASM_COMPILER "${_prefix}gcc")
set(CMAKE_AR "${_prefix}gcc-ar")
set(CMAKE_RANLIB "${_prefix}gcc-ranlib")
set(CMAKE_OBJCOPY "${_prefix}objcopy" CACHE FILEPATH "")
set(CMAKE_SIZE "${_prefix}size" CACHE FILEPATH "")
set(_flags "-mcpu=d25f -mext-dsp -mcmodel=medium -O2 -g3 -ffunction-sections -fdata-sections -fno-strict-aliasing -fomit-frame-pointer -fno-jump-tables -flto -fno-fat-lto-objects")
set(CMAKE_C_FLAGS_INIT "${_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_flags}")
set(CMAKE_ASM_FLAGS_INIT "${_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostartfiles -fuse-ld=bfd -Wl,--gc-sections")
set(CMAKE_FIND_ROOT_PATH "${TL3238_TOOLCHAIN}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
