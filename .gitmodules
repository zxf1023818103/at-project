[submodule "ameba-rtos"]
	path = platform/ameba-rtos
	url = https://github.com/zxf1023818103/ameba-rtos.git
	branch = at
[submodule "platform/toolchain_gcc_t-head_linux"]
	path = platform/toolchain_gcc_t-head_linux
	url = https://github.com/bouffalolab/toolchain_gcc_t-head_linux.git
[submodule "platform/ameba-rtos-d"]
	path = platform/ameba-rtos-d
	url = https://github.com/zxf1023818103/ameba-rtos-d.git
[submodule "platform/bouffalo_sdk"]
	path = platform/bouffalo_sdk
	url = https://github.com/zxf1023818103/bouffalo_sdk.git
	branch = at-v2.3.26
[submodule "component/zlib"]
	path = component/thirdparty/zlib
	url = https://github.com/madler/zlib.git
[submodule "component/freertos-kernel"]
	path = component/thirdparty/freertos-kernel
	url = https://github.com/zxf1023818103/FreeRTOS-Kernel.git
	branch = bouffalo-port
[submodule "component/lwip"]
	path = component/thirdparty/lwip
	url = https://github.com/zxf1023818103/lwip.git
	branch = bouffalo-port
[submodule "component/cjson"]
	path = component/thirdparty/cjson
	url = https://github.com/DaveGamble/cJSON.git
[submodule "component/mbedtls"]
	path = component/thirdparty/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
	branch = v3.6.4
[submodule "component/littlefs"]
	path = component/thirdparty/littlefs
	url = https://github.com/littlefs-project/littlefs.git
	branch = v2.8.2
[submodule "component/lfs_image/mklittlefs"]
	path = component/lfs_image/mklittlefs
	url = https://github.com/zxf1023818103/mklittlefs.git
	branch = at-project
[submodule "component/thirdparty/freertos-plus-tcp"]
	path = component/thirdparty/freertos-plus-tcp
	url = https://github.com/FreeRTOS/FreeRTOS-Plus-TCP.git
[submodule "component/thirdparty/wolfssl"]
	path = component/thirdparty/wolfssl
	url = https://github.com/wolfSSL/wolfssl.git
	branch = v5.9.1-stable
	shallow = true
[submodule "component/thirdparty/nimble"]
	path = component/thirdparty/nimble
	url = https://github.com/apache/mynewt-nimble
[submodule "component/thirdparty/ngtcp2"]
	path = component/thirdparty/ngtcp2
	url = https://github.com/ngtcp2/ngtcp2
[submodule "component/thirdparty/trusted-firmware-m"]
	path = component/thirdparty/trusted-firmware-m
	url = https://github.com/TrustedFirmware-M/trusted-firmware-m.git
