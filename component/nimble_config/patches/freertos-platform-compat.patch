diff --git a/porting/npl/freertos/include/nimble/nimble_npl_os.h b/porting/npl/freertos/include/nimble/nimble_npl_os.h
index 44d216c8..0f229a9a 100644
--- a/porting/npl/freertos/include/nimble/nimble_npl_os.h
+++ b/porting/npl/freertos/include/nimble/nimble_npl_os.h
@@ -283,7 +283,9 @@ ble_npl_hw_set_isr(int irqn, void (*addr)(void))
 static inline uint32_t
 ble_npl_hw_enter_critical(void)
 {
-    vPortEnterCritical();
+    /* Portable FreeRTOS critical section: taskENTER_CRITICAL() maps to the right
+     * port impl (ARM vPortEnterCritical / RISC-V vTaskEnterCritical). */
+    taskENTER_CRITICAL();
     s_critical_nesting++;
     return 0;
 }
@@ -294,7 +296,7 @@ ble_npl_hw_exit_critical(uint32_t ctx)
     if (s_critical_nesting > 0) {
         s_critical_nesting--;
     }
-    vPortExitCritical();
+    taskEXIT_CRITICAL();
 }
 
