/* rom_symbol_crypto.ld - RTL8721D va0 ROM crypto entry points
 * (rtl_aes_* / rtl_mpi_* / rtl_ecp_* / rtl_md5_*) needed by the newer
 * TizenRT lib_wlan_fpu.a WPA / WPA3-SAE path. Addresses lifted verbatim
 * from TizenRT build/configs/rtl8721csm/scripts/rlx8721d_img2_is.ld -
 * same va0 silicon/ROM as our chip (rtl_aes_init=0x1011e569 cross-checked
 * against reference_amebad_hw_crypto). rom_ssl_ram_map / p_rom_ssl_ram_map
 * come separately from mbedtls_rom.ld. PROVIDE() so a real def could win. */
PROVIDE(rtl_aes_crypt_cbc = 0x1011f1c9);
PROVIDE(rtl_aes_crypt_cfb128 = 0x1011f3d5);
PROVIDE(rtl_aes_crypt_cfb8 = 0x1011f44b);
PROVIDE(rtl_aes_crypt_ctr = 0x1011f4b1);
PROVIDE(rtl_aes_crypt_ecb = 0x1011f145);
PROVIDE(rtl_aes_decrypt = 0x1011ecf9);
PROVIDE(rtl_aes_encrypt = 0x1011e8c1);
PROVIDE(rtl_aes_free = 0x1011e579);
PROVIDE(rtl_aes_init = 0x1011e569);
PROVIDE(rtl_aes_setkey_dec = 0x1011e7a5);
PROVIDE(rtl_aes_setkey_enc = 0x1011e58d);
PROVIDE(rtl_ecp_check_privkey = 0x10126c2d);
