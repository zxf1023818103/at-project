/* ROM symbol table for the AmebaD A-cut (RTL8721D) mask-ROM mbedTLS 2.4.0 + the
 * SSL ram map (rom_ssl_ram_map / p_rom_ssl_ram_map). Moved out of
 * app_km4/rlx8721d_rom_symbol_acut.ld so the ROM-mbedtls support lives with the
 * component that consumes it (rom_mbedtls_crypto.h / rom_mbedtls.c).
 *
 * Cat'd into the KM4 image2 combined linker script (see app_km4/CMakeLists.txt).
 * PROVIDE (not absolute) so a real compiled definition, if ever linked, wins and
 * unreferenced entries cost nothing; references resolve to the mask ROM.
 */
PROVIDE(p_rom_ssl_ram_map = 0x10001348);
PROVIDE(rom_ssl_ram_map = 0x1000134c);
