  "findings": [
    {
      "priority": 1,
      "item": "PASN Auth1 received before peer context is available",
      "evidence": "All three missing-peer warnings follow alg=7 seq=1 status=0 and precede a peer-allocation log. Stress warnings occur before the first success and after four successes, consistent with failed rounds 1 and 6.",
      "binary_path": "rtw_nan_data_psan.o:rtw_nan_pasn_rx_checking +0x48 calls peer_info_get; null path +0x50..0x78 logs and returns 0, bypassing PASN_START at +0x1d6. rtw_mgnt.o:rtw_on_auth +0x1e..0x24 calls checking and returns without local retry.",
      "decision": "Prioritize bounded handling of a valid early Auth1 until peer context exists, preserving authentication and lifecycle validation. The discarded authentication attempt is confirmed; a fix/retest is still required to prove elimination of the 30-second app timeouts."
    },
    {
      "priority": 2,
      "item": "Repeated bandwidth compatibility log",
      "evidence": "Long release transfer has 56 upload + 48 download messages; short current transfer has 24 + 16. Channels 149 and 36 remain 5 GHz. Local CONFIG_BW_MODE=0x00 describes 20 MHz.",
      "binary_path": "rtw_nan_attr12_avl.o:_rtw_nan_avail_attr_parse_channel_entry checks g_hal_spec bandwidth capabilities and logs at +0xd8 before updating parsed channel width. It is a parser fallback, not evidence of 104 live link downgrades.",
      "decision": "Candidate: first occurrence plus periodic count or per-peer/capability-change reporting. Keep errors visible. A=ALWAYS is level 1, so WARN level 3 does not suppress it. Do not force 80 MHz or infer a silicon bandwidth limit from this message."
    },
    {
      "priority": 3,
      "item": "Repeated NDL/FAW scheduling",
      "evidence": "Long transfer has 13 refreshes, 78 adds and 78 removes. Two printed six-entry schedule shapes alternate; only one adjacent pair is identical.",
      "decision": "Most updates change actual channel/time-slot tuples. Measure update duration and data pause first. Only consider deduplication after validating full timing, generation and peer/NDC semantics; identical printed tuples are insufficient."
    },
    {
      "priority": 4,
      "item": "dw early: nanctrl_propagation",
      "binary_path": "rtw_nan_dw.o:rtw_nan_dw_early_hdl +0xbe..0xdc checks a propagation flag, logs W, and starts a beacon; the warning condition is not a measured deadline-overrun comparison.",
      "evidence": "One in failed cold-start capture and one in successful final-release setup; none in either principal bulk transfer capture.",
      "decision": "Keep as a state diagnostic or make it a counted informational event. It is not sufficient evidence of timer lateness or a throughput bottleneck."
    },
    {
