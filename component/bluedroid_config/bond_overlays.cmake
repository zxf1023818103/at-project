# Host-only overlays: shared by every platform and native interop tests.
function(bluedroid_generate_bond_overlays host output)
file(MAKE_DIRECTORY "${output}")
set(_btc_config "${host}/btc/core/btc_config.c")
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_btc_config}")
endif()
file(READ "${_btc_config}" _source)
string(FIND "${_source}" "    config = config_new(CONFIG_FILE_PATH);" _start)
string(FIND "${_source}" "    if (config_save(config, CONFIG_FILE_PATH))" _end)
if(_start EQUAL -1 OR _end LESS _start)
    message(FATAL_ERROR "Review Bluedroid persistent config initialization")
endif()
string(SUBSTRING "${_source}" 0 ${_start} _prefix)
string(SUBSTRING "${_source}" ${_end} -1 _suffix)
set(_source "${_prefix}    config = config_new(CONFIG_FILE_PATH);\n    if (!config) goto error;\n${_suffix}")
string(REPLACE "config_new(CONFIG_FILE_PATH)" "ble_bond_config_new(CONFIG_FILE_PATH)" _source "${_source}")
string(REPLACE "config_save(config, CONFIG_FILE_PATH)" "ble_bond_config_save(config, CONFIG_FILE_PATH)" _source "${_source}")
set(_initial_save "    if (ble_bond_config_save(config, CONFIG_FILE_PATH)) {\n        // unlink(LEGACY_CONFIG_FILE_PATH);\n    }")
string(FIND "${_source}" "${_initial_save}" _found)
if(_found EQUAL -1)
    message(FATAL_ERROR "Review initial bond/config commit error propagation")
endif()
string(REPLACE "${_initial_save}"
    "    if (!ble_bond_config_save(config, CONFIG_FILE_PATH)) goto error;" _source "${_source}")
set(_source "#include \"bond_config.h\"\n#include \"btc/btc_config.h\"\n${_source}")
file(CONFIGURE OUTPUT "${output}/btc_config_lfs.c" CONTENT "${_source}" @ONLY)
foreach(_unit btc/core/btc_dm stack/smp/smp_act)
    set(_original "${host}/${_unit}.c")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_original}")
    endif()
    file(READ "${_original}" _source)
    if(_unit STREQUAL "btc/core/btc_dm")
        set(_needle "        int addr_type = BLE_ADDR_PUBLIC;")
        string(FIND "${_source}" "${_needle}" _found)
        if(_found EQUAL -1)
            message(FATAL_ERROR "Review bond transaction start overlay")
        endif()
        string(REPLACE "${_needle}" "        ble_bond_config_defer(true);\n${_needle}" _source "${_source}")
        set(_needle "        btc_dm_save_ble_bonding_keys();")
        string(FIND "${_source}" "${_needle}" _found)
        if(_found EQUAL -1)
            message(FATAL_ERROR "Review bond transaction commit overlay")
        endif()
        string(REPLACE "${_needle}" "${_needle}\n        ble_bond_config_defer(false);\n        btc_config_lock();\n        btc_config_flush();\n        btc_config_unlock();" _source "${_source}")
    else()
        set(_needle "        btm_sec_save_le_key(p_cb->pairing_bda, BTM_LE_KEY_LENC,")
        string(FIND "${_source}" "${_needle}" _found)
        if(_found EQUAL -1)
            message(FATAL_ERROR "Review local LTK metadata overlay")
        endif()
        string(REPLACE "${_needle}" "        ble_bond_config_capture_lenc(p_cb->pairing_bda, p_cb->ediv, p_cb->enc_rand);\n${_needle}" _source "${_source}")
        # check_auth_req also handles encryption with a previously stored LTK.
        # Keep those keys unless this encryption follows a new SMP pairing.
        set(_needle "        if (p_dev_rec) {\n            if (p_dev_rec->ble.key_type & (BTM_LE_KEY_PENC | BTM_LE_KEY_LENC)) {")
        string(FIND "${_source}" "${_needle}" _found)
        if(_found EQUAL -1)
            message(FATAL_ERROR "Review reconnect bond preservation overlay")
        endif()
        string(REPLACE "${_needle}" "        if (p_dev_rec && (p_cb->flags & SMP_PAIR_FLAG_ENC_AFTER_PAIR)) {\n            if (p_dev_rec->ble.key_type & (BTM_LE_KEY_PENC | BTM_LE_KEY_LENC)) {" _source "${_source}")
    endif()
    get_filename_component(_name "${_unit}" NAME)
    set(_generated "${output}/${_name}_bonds.c")
    set(_source "#include \"bond_config.h\"\n#include \"btc/btc_config.h\"\n${_source}")
    file(CONFIGURE OUTPUT "${_generated}" CONTENT "${_source}" @ONLY)

endforeach()
endfunction()
if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT BLUEDROID_HOST_ROOT OR NOT BOND_OUTPUT_DIR)
        message(FATAL_ERROR "Set BLUEDROID_HOST_ROOT and BOND_OUTPUT_DIR")
    endif()
    bluedroid_generate_bond_overlays("${BLUEDROID_HOST_ROOT}" "${BOND_OUTPUT_DIR}")
endif()
