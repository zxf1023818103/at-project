CONFIG_FREERTOS =y
CONFIG_SHELL =y
CONFIG_BFLB_LOG =n
ifeq ($(CHIP),bl618dg)
CONFIG_RAM_FOR_AP_SIZE =0x50000
CONFIG_WRAM_FOR_AP_SIZE =0x50000
endif
ifneq ($(filter y,$(CONFIG_PAN_RF_DIAG)),)
CONFIG_BLUETOOTH =y
else ifeq ($(CONFIG_PAN_WIFI_ONLY),y)
CONFIG_BLUETOOTH =n
else
CONFIG_BLUETOOTH =y
endif
CONFIG_BTBLECONTROLLER_LIB =ble1m2s1bredr1
CONFIG_BLE_HOST_DISABLE =y
CONFIG_RF =y
CONFIG_LITTLEFS =y
CONFIG_BFLB_MTD =y
CONFIG_PARTITION =y

ifneq ($(filter y,$(CONFIG_PAN_COEX) $(CONFIG_PAN_WIFI_ONLY)),)
CONFIG_WIFI6 =y
CONFIG_FHOST =y
CONFIG_MACSW_SELECT =default
ifeq ($(CONFIG_PAN_COEX),y)
CONFIG_BT_PATH =y
endif
CONFIG_MBEDTLS =y
CONFIG_POSIX =y
endif
# Official BL618DG coexistence runs the radio stacks on AP without starting NP.
ifeq ($(CHIP),bl618dg)
CONFIG_DUALCORE_DISABLE =y
endif
CONFIG_ROMAPI =n
