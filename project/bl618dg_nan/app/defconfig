CONFIG_FREERTOS =y
CONFIG_SHELL =y
CONFIG_CONSOLE_UART_BAUDRATE =500000
CONFIG_BFLB_LOG =n
CONFIG_CHERRYUSB =y
CONFIG_CHERRYUSB_OSAL =freertos
CONFIG_CHERRYUSB_DEVICE =y
CONFIG_CHERRYUSB_HOST =y
CONFIG_BSP_USB =y
CONFIG_ROMAPI =n
# NAN throughput JSON and diagnostics use PRIu64 (llu on RV32).
CONFIG_VSNPRINTF_LONG_LONG =y
CONFIG_RAM_FOR_AP_SIZE =0x50000
CONFIG_WRAM_FOR_AP_SIZE =0x50000
CONFIG_DUALCORE_DISABLE =y

CONFIG_PSRAM =y
CONFIG_PSRAM_FOR_AP_SIZE =0x400000
# Run code/rodata from PSRAM to reduce measured packet-processing latency.
CONFIG_PSRAM_COPY_CODE =y
