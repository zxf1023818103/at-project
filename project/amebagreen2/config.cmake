option(AT_ENABLE_TFM "Build KM4TZ as TF-M nonsecure firmware" OFF)
option(AT_ENABLE_STORAGE "Enable TF-M ITS and protected storage" OFF)
option(AT_ENABLE_USB_BENCH "CherryUSB host/device Bulk benchmark" OFF)
set(AT_USB_BENCH_ROLE "device" CACHE STRING "CherryUSB role: host or device")
if(AT_ENABLE_USB_BENCH)
    if(NOT AT_USB_BENCH_ROLE MATCHES "^(host|device)$")
        message(FATAL_ERROR "AT_USB_BENCH_ROLE must be host or device")
    endif()
    add_compile_definitions(AT_ENABLE_USB_BENCH)
endif()
option(AT_ENABLE_NAN "Standalone Wi-Fi Aware publisher and TCP responder" OFF)
option(AT_NAN_BLE_OOB "Deliver a temporary NAN PIN over encrypted BLE GATT" OFF)
option(AT_ENABLE_BLE_POWER_TEST "BLE advertising-only current measurement profile" OFF)
option(AT_NAN_USB_BRIDGE "Forward NAN radio APIs/packets to an external FreeRTOS host over USB" OFF)
option(AT_ENABLE_BLE_NAN_WAKE "Advertise in PG; start standalone NAN on BLE connection" OFF)
option(AT_ENABLE_NAN_DEEP_SLEEP "Enter SoC DSLP after NAN transfer; boot NAN on timer/power wake" OFF)
if(AT_NAN_BLE_OOB)
    set(AT_ENABLE_NAN ON CACHE BOOL "Standalone Wi-Fi Aware" FORCE)
    set(AT_ENABLE_NIMBLE ON CACHE BOOL "NimBLE host" FORCE)
    if(AT_ENABLE_HCI OR AT_ENABLE_MCUMGR OR AT_ENABLE_BLE_POWER_TEST OR
       AT_ENABLE_BLE_NAN_WAKE OR AT_ENABLE_NAN_DEEP_SLEEP OR AT_NAN_USB_BRIDGE)
        message(FATAL_ERROR "NAN_BLE_OOB requires HCI=OFF, MCUMGR=OFF, BLE_POWER_TEST=OFF, BLE_NAN_WAKE=OFF, NAN_DEEP_SLEEP=OFF, NAN_USB=OFF")
    endif()
    add_compile_definitions(AT_NAN_BLE_OOB)
endif()
if(AT_ENABLE_BLE_POWER_TEST)
    if(NOT AT_ENABLE_NIMBLE OR AT_ENABLE_NAN OR AT_ENABLE_TFM OR AT_ENABLE_USB_BENCH)
        message(FATAL_ERROR "BLE_POWER_TEST requires NIMBLE=ON, NAN=OFF, TFM=OFF, USB_BENCH=OFF")
    endif()
    add_compile_definitions(AT_ENABLE_BLE_POWER_TEST AT_GREEN2_BLE_SLEEP)
endif()
if(AT_ENABLE_BLE_NAN_WAKE)
    if(NOT AT_ENABLE_NIMBLE OR NOT AT_ENABLE_NAN OR AT_NAN_USB_BRIDGE OR
       AT_ENABLE_BLE_POWER_TEST OR AT_ENABLE_TFM OR AT_ENABLE_USB_BENCH)
        message(FATAL_ERROR "BLE_NAN_WAKE requires NIMBLE=ON, NAN=ON, NAN_USB=OFF, BLE_POWER_TEST=OFF, TFM=OFF, USB_BENCH=OFF")
    endif()
    add_compile_definitions(AT_ENABLE_BLE_NAN_WAKE AT_GREEN2_BLE_SLEEP AT_NAN_AUTO_SLEEP)
endif()
set(AT_NAN_DEEP_SLEEP_MS "30000" CACHE STRING "AON deep sleep duration in ms; 0 disables timed wake")
if(AT_ENABLE_NAN_DEEP_SLEEP)
    if(NOT AT_ENABLE_NAN OR AT_ENABLE_NIMBLE OR AT_ENABLE_BLE_NAN_WAKE OR
       AT_ENABLE_BLE_POWER_TEST OR AT_NAN_USB_BRIDGE OR AT_ENABLE_TFM OR AT_ENABLE_USB_BENCH)
        message(FATAL_ERROR "NAN_DEEP_SLEEP requires NAN=ON, NIMBLE=OFF, BLE_NAN_WAKE=OFF, BLE_POWER_TEST=OFF, NAN_USB=OFF, TFM=OFF, USB_BENCH=OFF")
    endif()
    if(NOT AT_NAN_DEEP_SLEEP_MS MATCHES "^[0-9]+$" OR AT_NAN_DEEP_SLEEP_MS GREATER 3600000)
        message(FATAL_ERROR "NAN_DEEP_SLEEP_MS must be 0..3600000")
    endif()
    add_compile_definitions(AT_ENABLE_NAN_DEEP_SLEEP AT_NAN_AUTO_SLEEP
        AT_NAN_DEEP_SLEEP_MS=${AT_NAN_DEEP_SLEEP_MS})
endif()
if(AT_NAN_USB_BRIDGE)
    if(NOT AT_ENABLE_NAN OR AT_ENABLE_USB_BENCH)
        message(FATAL_ERROR "NAN USB bridge requires NAN=ON and USB_BENCH=OFF")
    endif()
    add_compile_definitions(AT_NAN_USB_BRIDGE)
endif()
option(AT_NAN_HEAP_CHECKS "Check TLSF heaps around NAN authentication/IPC" OFF)
option(AT_NAN_NP_HEAP_TRACE "Track NP allocation ownership at NAN idle snapshots" OFF)
option(AT_NAN_NET_DIAG "Record NAN TCP packet timings without packet-path logging" OFF)
if(AT_ENABLE_NAN)
    add_compile_definitions(AT_GREEN2_NAN AT_NET_LOW_MEM)
    if(AT_NAN_HEAP_CHECKS)
        add_compile_definitions(AT_NAN_HEAP_CHECKS)
    endif()
endif()
# Use the kernel's next deadline for the AP PMC timer. The SDK's alternative
# policy defaults to sleeping forever, which also stops the NP watchdog task.
add_compile_definitions(CONFIG_STANDARD_TICKLESS)
if(AT_ENABLE_AWS OR AT_ENABLE_MINIMAL)
    # Match AmebaD's MQTT profile; throughput-sized socket buffers otherwise
    # consume the heap needed by the OTA worker when all services are enabled.
    add_compile_definitions(AT_NET_LOW_MEM)
endif()
if(AT_ENABLE_STORAGE AND NOT AT_ENABLE_TFM)
    message(FATAL_ERROR "STORAGE requires TFM")
endif()
if(AT_ENABLE_TFM AND AMEBAGREEN2_CORE STREQUAL "km4tz")
    add_compile_definitions(AT_ENABLE_TFM CONFIG_TRUSTZONE CONFIG_TRUSTZONE_EN=1
        CONFIG_IMG3_SRAM CONFIG_TZ_S_SIZE=64)
    set(AMEBAGREEN2_LD_DEFINES -DCONFIG_TRUSTZONE -DCONFIG_TRUSTZONE_EN=1
        -DCONFIG_IMG3_SRAM -DCONFIG_TZ_S_SIZE=64)
    if(AMEBAGREEN2_IMAGE STREQUAL "app_km4tz")
        # Only SPE may emit secure entry veneers; image2 executes in NS state.
        foreach(lang C CXX ASM EXE_LINKER)
            string(REPLACE " -mcmse" "" CMAKE_${lang}_FLAGS "${CMAKE_${lang}_FLAGS}")
        endforeach()
    endif()
endif()
