# Shared services use the same options/defaults as project/amebad.
list(APPEND libs dsleep_cli flash_cli)
target_sources(${name} PRIVATE ${AT_ROOT}/component/amebagreen2/board_flash_port/board_flash_green2.c)
option(AT_ENABLE_CARES "Use c-ares DNS" ON)
option(AT_ENABLE_NIMBLE "Build the NimBLE host and Green2 controller transport" OFF)
option(AT_ENABLE_AWS "Build the shared AWS telemetry client" OFF)
option(AT_ENABLE_IPERF "Build iperf console probes" ON)
option(AT_ENABLE_MINIMAL "Strip optional diagnostics" OFF)
option(AT_CRYPTO_SELFTESTS "Build crypto diagnostic commands" OFF)
option(AT_ENABLE_PKCS11 "Run the shared PKCS11 self-test at boot" OFF)
option(AT_ENABLE_BENCH "Run the shared crypto benchmark at boot" OFF)
option(AT_VFS_SELFTEST "Run POSIX file and socket tests" OFF)
option(AT_CPP_SELFTEST "Run C++ filesystem and iostream tests" OFF)
option(AT_EFUSE_DEBUG "Include irreversible debug OTP provisioning commands" OFF)
if(AT_EFUSE_DEBUG)
    target_compile_definitions(${name} PRIVATE AT_EFUSE_DEBUG)
    target_sources(${name} PRIVATE ${AT_ROOT}/component/amebagreen2/efuse_port/efuse_cli.c)
    if(NOT AT_ENABLE_TFM)
        target_sources(${name} PRIVATE ${AT_ROOT}/component/amebagreen2/efuse_port/efuse_debug.c)
        target_compile_definitions(${name} PRIVATE GREEN2_EFUSE_SECURE)
    endif()
endif()
if(AT_ENABLE_CARES)
    list(APPEND libs cares_port c_ares)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_CARES)
    foreach(t sntp_time net_cli network_transport_sockets)
        target_compile_definitions(${t} PRIVATE AT_PROJECT_CARES)
        target_link_libraries(${t} PRIVATE cares_port)
    endforeach()
endif()
if(AT_ENABLE_IPERF AND NOT AT_ENABLE_MINIMAL)
    list(APPEND libs iperf)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_IPERF)
endif()
if(NOT AT_ENABLE_AWS)
    list(APPEND libs zip_cmd minizip zlibstatic)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_MINIZIP)
else()
    list(APPEND libs aws_iot aws_provision_core)
    if(AT_ENABLE_STORAGE)
        target_sources(${name} PRIVATE ${AT_ROOT}/component/aws_iot_config/aws_secret_store_its.c)
        # The shared AWS library defaults to the file backend on other targets.
        get_target_property(_aws_links aws_iot INTERFACE_LINK_LIBRARIES)
        list(REMOVE_ITEM _aws_links aws_secret_store_file)
        set_property(TARGET aws_iot PROPERTY INTERFACE_LINK_LIBRARIES "${_aws_links}")
    else()
        list(APPEND libs aws_secret_store_file)
    endif()
    target_compile_definitions(${name} PRIVATE AT_PROJECT_AWS)
    target_sources(${name} PRIVATE ${OTA_HTTP_SOURCES})
    target_compile_definitions(${name} PRIVATE OTA_HTTP_RX_BUFFER_BYTES=11680 OTA_HTTP_TX_BUFFER_BYTES=2920)
    list(APPEND libs ota_flash_port ota_http_config corehttp_config network_transport_${TLS_BACKEND})
    if(AT_ENABLE_AWS_OTA)
        target_compile_definitions(${name} PRIVATE AT_PROJECT_AWS_OTA)
    endif()
    if(AT_ENABLE_CRT_BUNDLE)
        list(APPEND libs esp_crt_bundle_config)
        target_compile_definitions(aws_provision_core PRIVATE AT_PROJECT_CRT_BUNDLE)
        target_compile_definitions(aws_iot PRIVATE AT_PROJECT_CRT_BUNDLE)
        target_link_libraries(aws_iot PRIVATE esp_crt_bundle_config)
    endif()
endif()
if(AT_ENABLE_MCUMGR)
    target_sources(${name} PRIVATE ${AT_ROOT}/component/mcumgr_config/smp_img_ota.c
                                  ${AT_ROOT}/component/mcumgr_config/smp_fs.c)
    list(APPEND libs mcumgr mcumgr_port tinycbor ota_flash_port)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_MCUMGR)
endif()
if(AT_ENABLE_NIMBLE)
    list(APPEND libs nimble nimble_config amebagreen2_hci)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_NIMBLE)
endif()
if(AT_ENABLE_HCI)
    if(AT_ENABLE_NIMBLE)
        message(FATAL_ERROR "HCI and NIMBLE are mutually exclusive")
    endif()
    target_sources(${name} PRIVATE ${AT_ROOT}/component/amebagreen2/hci/bridge.c)
    list(APPEND libs amebagreen2_hci)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_HCI)
endif()
if(AT_CRYPTO_SELFTESTS)
    list(APPEND libs mbedtls_bench pkcs11_selftest esp_crt_bundle_config crt_bundle_cli)
    target_compile_definitions(${name} PRIVATE AT_CRYPTO_SELFTESTS)
endif()
if(AT_ENABLE_PKCS11)
    list(APPEND libs pkcs11_selftest)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_PKCS11)
endif()
if(AT_ENABLE_BENCH)
    list(APPEND libs mbedtls_bench)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_CRYPTOBENCH)
endif()
if(AT_VFS_SELFTEST)
    target_compile_definitions(${name} PRIVATE AT_PROJECT_VFS_SELFTEST)
    target_compile_definitions(lfs_config PRIVATE AT_PROJECT_VFS_SELFTEST)
    target_link_libraries(lfs_config PRIVATE freertos_plus_tcp)
    target_include_directories(lfs_config PRIVATE ${AT_ROOT}/component/syscall_config)
endif()
if(AT_CPP_SELFTEST)
    target_sources(${name} PRIVATE ${AT_ROOT}/component/littlefs_config/cpp_selftest.cpp)
    target_compile_definitions(${name} PRIVATE AMEBAD_CPP_SELFTEST AT_CPP_SELFTEST_NONINTERACTIVE)
    list(APPEND libs stdc++)
endif()
if(AT_ENABLE_MCUMGR OR AT_ENABLE_AWS_OTA)
    # ASDK 4523 emits NEON lane loads for TinyCBOR's half-float conversion on
    # armv8.1-m, although this core has scalar FP only. Use TinyCBOR's integer path.
    target_compile_definitions(tinycbor PRIVATE CBOR_NO_HALF_FLOAT_TYPE)
endif()
if(AT_ENABLE_WPS OR AT_ENABLE_EAP)
    list(APPEND libs amebagreen2_wifi_provision)
    target_compile_definitions(${name} PRIVATE AT_WIFI_PROVISION)
endif()
if(AT_ENABLE_QUIC)
    target_sources(${name} PRIVATE ${AT_ROOT}/component/quic_selftest_config/quic_test.c)
    list(APPEND libs ngtcp2_crypto_picotls ngtcp2_static picotls_core picotls_mbedtls)
    target_compile_definitions(${name} PRIVATE AT_ENABLE_QUIC)
    set(AT_QUIC_SERVER "192.168.4.250" CACHE STRING "QUIC test peer IPv4 address")
    string(REPLACE "." ";" _quic_ip "${AT_QUIC_SERVER}")
    list(LENGTH _quic_ip _quic_octets)
    if(NOT _quic_octets EQUAL 4)
        message(FATAL_ERROR "AT_QUIC_SERVER must be an IPv4 address")
    endif()
    foreach(i RANGE 0 3)
        list(GET _quic_ip ${i} octet)
        if(NOT octet MATCHES "^[0-9]+$" OR octet GREATER 255)
            message(FATAL_ERROR "AT_QUIC_SERVER has an invalid octet")
        endif()
        target_compile_definitions(${name} PRIVATE QUIC_SERVER_A${i}=${octet})
    endforeach()
endif()
if(AT_TLS_HEAP_TRACE AND TARGET network_transport_picotls)
    target_compile_definitions(network_transport_picotls PRIVATE AT_PROJECT_TLS_HEAP_TRACE)
endif()
if(AT_ENABLE_ROM_KAT OR AT_ENABLE_HWGCM)
    target_sources(${name} PRIVATE ${AT_ROOT}/component/amebagreen2/mbedtls_port/crypto_kat.c)
    target_compile_definitions(${name} PRIVATE AT_GREEN2_CRYPTO_KAT)
endif()
if(AT_ENABLE_TFM)
    add_subdirectory(${AMEBAGREEN2_PROJECT}/app_km4tz_secure ${CMAKE_CURRENT_BINARY_DIR}/app_km4tz_secure)
    set(_tfm_src ${AT_ROOT}/component/trusted-firmware-m_config/trusted-firmware-m)
    set(_tfm_export ${CMAKE_CURRENT_BINARY_DIR}/app_km4tz_secure/tfm_spe_export)
    add_dependencies(${name} tfm_spe)
    target_sources(${name} PRIVATE ${AMEBAGREEN2_PROJECT}/app_km4tz/tfm_client.c
        ${_tfm_src}/interface/src/tfm_platform_api.c
        ${_tfm_src}/interface/src/tfm_tz_psa_ns_api.c
        ${_tfm_src}/interface/src/os_wrapper/tfm_ns_interface_rtos.c)
    target_include_directories(${name} PRIVATE ${_tfm_export}/interface/include ${_tfm_src}/interface/include)
    list(APPEND libs ${_tfm_export}/interface/lib/s_veneers.o)
    target_link_options(${name} PRIVATE -Wl,--wrap=FLASH_WriteStream -Wl,--wrap=FLASH_EraseXIP)
    if(AT_ENABLE_STORAGE)
        target_compile_definitions(${name} PRIVATE AT_ENABLE_STORAGE)
        target_sources(${name} PRIVATE ${AMEBAGREEN2_PROJECT}/app_km4tz/tfm_storage_test.c
            ${_tfm_src}/interface/src/tfm_its_api.c ${_tfm_src}/interface/src/tfm_ps_api.c)
    endif()
endif()
